<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <TextureView
        android:id="@+id/cameraTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.wcam.app.ui.ParkingLinesView
        android:id="@+id/parkingLinesView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Connection Waiting Card (hidden automatically when video streams) -->
    <LinearLayout
        android:id="@+id/waitingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:alpha="0.85"
            android:src="@drawable/ic_camera" />

        <TextView
            android:id="@+id/waitingStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="280dp"
            android:text="@string/status_waiting_camera"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/waitingSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxWidth="280dp"
            android:text="@string/status_connect_camera_wifi"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWaitingWifi"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_hud_btn"
                android:paddingHorizontal="14dp"
                android:text="@string/btn_wifi_settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnWaitingRetry"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_hud_btn"
                android:paddingHorizontal="14dp"
                android:text="@string/btn_retry"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Always-visible Recording Badge -->
    <LinearLayout
        android:id="@+id/recordingBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rec_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_record" />

        <TextView
            android:id="@+id/recordingTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/rec_timer_initial"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top HUD Bar -->
    <LinearLayout
        android:id="@+id/topHudBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_status" />

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_waiting_short"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnCalibrate"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tune" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/btn_calibrate"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnWifi"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_wifi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/btn_wifi"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnLanguage"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_pill"
            android:clickable="true"
            android:contentDescription="@string/cd_language"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/labelLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_language_code"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Calibration Mode Bar -->
    <LinearLayout
        android:id="@+id/calibrationBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calibration_hint"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCalibReset"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_hud_btn"
            android:paddingHorizontal="12dp"
            android:text="@string/btn_reset"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCalibDone"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_btn"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_done"
            android:textAllCaps="false"
            android:textColor="#FF2ED573"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom HUD Bar -->
    <LinearLayout
        android:id="@+id/bottomHudBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- Parking Lines Toggle -->
        <LinearLayout
            android:id="@+id/btnLines"
            android:layout_width="62dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_hud_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconLines"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_lines" />

            <TextView
                android:id="@+id/labelLines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/btn_lines"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Record Toggle -->
        <LinearLayout
            android:id="@+id/btnRecord"
            android:layout_width="62dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconRecord"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_record" />

            <TextView
                android:id="@+id/labelRecord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/btn_record"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Snapshot -->
        <LinearLayout
            android:id="@+id/btnPhoto"
            android:layout_width="62dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_camera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/btn_photo"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Mirror Toggle -->
        <LinearLayout
            android:id="@+id/btnMirror"
            android:layout_width="62dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconMirror"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_mirror" />

            <TextView
                android:id="@+id/labelMirror"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/btn_mirror"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Switch to Overlay -->
        <LinearLayout
            android:id="@+id/btnOverlay"
            android:layout_width="62dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_overlay" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/btn_overlay"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
